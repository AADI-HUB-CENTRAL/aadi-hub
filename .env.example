# ---------------------------------------------------------------------------
# AADI HUB — environment variables
# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values.
# `.env` is git-ignored. Never commit it.
#
# IMPORTANT: Vite inlines every VITE_* variable into the public JS bundle.
# Anything starting with VITE_ is readable by anyone who loads the site.
# NEVER put a secret here — in particular NEVER put a Supabase service-role key.
# ---------------------------------------------------------------------------

# --- Supabase (required for authentication, profiles, dashboard data) -------
# From: Supabase Dashboard -> Project Settings -> API
#   Project URL  -> "Project URL"      -> paste into VITE_SUPABASE_URL
#   Publishable key -> "anon public" / "publishable" key
#                  -> paste into VITE_SUPABASE_PUBLISHABLE_KEY
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Canonical site URL. Used to build password-reset and email-verification links.
# Local dev:  http://localhost:5173
# Production: https://aadihub.com
VITE_PUBLIC_APP_URL=

# --- Existing integrations (unchanged) --------------------------------------
VITE_FORMSPREE_ENDPOINT=
VITE_WHATSAPP_COMMUNITY_URL=

# ---------------------------------------------------------------------------
# Values you must NEVER put in this file
# ---------------------------------------------------------------------------
# VITE_SUPABASE_SERVICE_ROLE_KEY=   <-- bypasses Row Level Security. Never.
# Any SMTP password, API secret, or private key.
